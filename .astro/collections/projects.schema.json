{
  "$ref": "#/definitions/projects",
  "definitions": {
    "projects": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "year": {
          "type": "string"
        },
        "order": {
          "type": "number"
        },
        "featured": {
          "type": "boolean",
          "default": false
        },
        "revStrip": {
          "type": "boolean",
          "default": false
        },
        "flatFileNo": {
          "type": "string"
        },
        "stackLabel": {
          "type": "string"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "links": {
          "type": "object",
          "properties": {
            "live": {
              "type": "string",
              "format": "uri"
            },
            "app": {
              "type": "string",
              "format": "uri"
            },
            "github": {
              "type": "string",
              "format": "uri"
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "primaryLink": {
          "type": "string",
          "enum": [
            "live",
            "app",
            "github",
            "study"
          ]
        },
        "internal": {
          "type": "string"
        },
        "cover": {
          "type": "string"
        },
        "coverAlt": {
          "type": "string"
        },
        "coverPosition": {
          "type": "string"
        },
        "textSheet": {
          "type": "object",
          "properties": {
            "kicker": {
              "type": "string"
            },
            "quote": {
              "type": "string"
            }
          },
          "required": [
            "kicker",
            "quote"
          ],
          "additionalProperties": false
        },
        "study": {
          "type": "string",
          "enum": [
            "written",
            "queued",
            "none"
          ],
          "default": "none"
        },
        "studyMeta": {
          "type": "object",
          "properties": {
            "drawingNo": {
              "type": "string"
            },
            "subtitle": {
              "type": "string"
            },
            "team": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "context": {
              "type": "string"
            },
            "stackLines": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deploy": {
              "type": "string"
            },
            "heroPlate": {
              "type": "object",
              "properties": {
                "image": {
                  "type": "string"
                },
                "alt": {
                  "type": "string"
                },
                "caption": {
                  "type": "string"
                },
                "badge": {
                  "type": "string"
                }
              },
              "required": [
                "image",
                "alt",
                "caption"
              ],
              "additionalProperties": false
            },
            "pullQuote": {
              "type": "string"
            }
          },
          "required": [
            "drawingNo"
          ],
          "additionalProperties": false
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "year",
        "order",
        "stackLabel"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}