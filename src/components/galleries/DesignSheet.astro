---
// SHEET 03 — Design work. 4-column plate grid: real tiles from
// src/data/galleries.ts plus dashed placeholder slots filling out the row.
import SectionHeader from "../SectionHeader.astro";
import GalleryTile from "./GalleryTile.astro";
import PlaceholderTile from "./PlaceholderTile.astro";
import Lightbox from "./Lightbox.astro";
import { designWorks } from "../../data/galleries";
import { SITE } from "../../data/site";

// Dashed slots fill the last 4-column row; they vanish as real plates land.
const placeholderCount = (4 - (designWorks.length % 4)) % 4;
---

<section id="design" class="sheet hairline-top" aria-label="Design work">
    <SectionHeader sheet="SHEET 03" title="Design work" aside="— marks & posters, the Behance shelf">
        <a class="shelf-link" href={SITE.behance} target="_blank" rel="noreferrer">
            BEHANCE — FULL SHELF ↗
        </a>
    </SectionHeader>

    <div class="gallery-grid">
        {
            designWorks.map((item) => (
                <GalleryTile
                    item={item}
                    lightboxId="design-lightbox"
                    widths={[320, 640]}
                    sizes="(max-width: 640px) calc(100vw - 40px), (max-width: 900px) 50vw, 25vw"
                />
            ))
        }
        {
            Array.from({ length: placeholderCount }, (_, i) => (
                <PlaceholderTile caption="DES-0XX — TITLE / YEAR" extra={i > 0} />
            ))
        }
    </div>

    <Lightbox id="design-lightbox" label="Design work lightbox" items={designWorks} />
</section>

<style>
    .sheet {
        padding: var(--space-section) var(--space-gutter) 72px;
    }

    .shelf-link {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.14em;
        color: var(--accent);
        text-decoration: none;
        white-space: nowrap;
    }

    .shelf-link:hover,
    .shelf-link:focus-visible {
        text-decoration: underline;
    }

    .gallery-grid {
        --tile-h: 260px;
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 24px;
    }

    @media (max-width: 900px) {
        .gallery-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    @media (max-width: 640px) {
        .gallery-grid {
            --tile-h: 240px;
            grid-template-columns: 1fr;
        }
    }
</style>
