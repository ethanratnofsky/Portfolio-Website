---
import Signature from "./Signature.astro";
import { currentSeason, record, seasonAgg } from "../data/soccer-derive";

const year = new Date().getFullYear();

/* Field-report easter egg (pre-approved in the handoff): the in-play season's
   record rides along on the copyright line, derived like everything else. */
const season = currentSeason();
const seasonRecord =
    season && seasonAgg(season.id).played > 0
        ? record(seasonAgg(season.id))
        : null;
const seasonName = season?.label.split(" ")[0].toLowerCase();
---

<footer class="site-footer hairline-top">
    <p class="mono-micro footer-cell">
        <span class="ext">Drawn by code, approved by hand — </span>© {year} E.R.{
            seasonRecord && (
                <span class="ext"> · {seasonRecord} this {seasonName}</span>
            )
        }
    </p>
    <button class="footer-sig" aria-label="Replay the hero draft animation" title="Replay the draft">
        <Signature />
    </button>
    <p class="mono-micro footer-cell right">
        <span class="ext">Set in Instrument Serif, Instrument Sans &amp; IBM Plex Mono</span>
        <span class="short">Drawn by code</span>
    </p>
</footer>

<style>
    /* 1fr auto 1fr pins the signature to the viewport center regardless of
       the differing side-label widths. */
    .site-footer {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 16px;
        padding: 22px var(--space-gutter);
    }

    .footer-cell {
        font-size: 10px;
        letter-spacing: 0.12em;
        color: var(--faint);
    }

    .footer-cell.right {
        justify-self: end;
        text-align: right;
    }

    .short {
        display: none;
    }

    .footer-sig {
        justify-self: center;
        color: var(--ink);
        opacity: 0.55;
        transition: opacity var(--dur-hover) var(--ease);
    }

    .footer-sig :global(.signature-svg) {
        height: 15px;
    }

    .footer-sig:hover {
        opacity: 1;
    }

    @media (max-width: 640px) {
        .ext {
            display: none;
        }

        .short {
            display: inline;
        }

        .footer-sig :global(.signature-svg) {
            height: 12px;
        }
    }
</style>

<script>
    // Easter egg: clicking the signature replays the hero draft.
    document.querySelector(".footer-sig")?.addEventListener("click", () => {
        if (document.getElementById("hero")) {
            const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
            window.scrollTo({ top: 0, behavior: reduced ? "auto" : "smooth" });
            window.dispatchEvent(new CustomEvent("compile:replay"));
        } else {
            window.location.href = "/?replay";
        }
    });
</script>
