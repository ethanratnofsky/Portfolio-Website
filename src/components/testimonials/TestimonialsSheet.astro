---
// ON RECORD — In their words (#6a In Their Words): testimonial register carousel.
// Sign-off cards in a scroll-snap track; sheets of 6 (3×2) on desktop, 4 (2×2)
// under 900px, 1 under 640px. The client script re-chunks pages per breakpoint.
import SectionHeader from "../SectionHeader.astro";
import { TESTIMONIALS } from "../../data/testimonials";

const entries = TESTIMONIALS.map((t, i) => ({
    ...t,
    num: String(i + 1).padStart(3, "0"),
    dateLabel: `${t.date.slice(5, 7)} / ${t.date.slice(0, 4)}`,
    // Stamp tilt cycles by register number so neighboring stamps sit differently.
    tilt: [-4, 3, -2][i % 3],
})).reverse(); // newest first — page 1 is the most recent sheet

const total = TESTIMONIALS.length;
const newestNum = String(total).padStart(3, "0");

// Server-side chunking matches the desktop layout; the script re-chunks live.
const PAGE_SIZE = 6;
const pages: (typeof entries)[] = [];
for (let i = 0; i < entries.length; i += PAGE_SIZE) {
    pages.push(entries.slice(i, i + PAGE_SIZE));
}
---

<section id="testimonials" class="sheet hairline-top" aria-label="In their words">
    <SectionHeader
        sheet="ON RECORD"
        title="In their words"
        aside="— colleagues, managers & teammates"
    >
        <p class="tw-count" data-tw-count>
            {total} ON FILE — SHEET 1 / {pages.length}
        </p>
    </SectionHeader>

    {/* Design puts 36px under the header; SectionHeader carries 32px. */}
    <div
        class="tw-carousel reveal"
        data-tw-carousel
        aria-roledescription="carousel"
        aria-label="Testimonial register"
    >
        <div class="tw-track" data-tw-track>
            {
                pages.map((page, p) => (
                    <div
                        class="tw-page"
                        role="group"
                        aria-label={`Sheet ${p + 1} of ${pages.length}`}
                    >
                        {page.map((t) => (
                            <article class="tw-card">
                                <p class="tw-meta">
                                    <span>NO. {t.num}</span>
                                    <span>{t.dateLabel}</span>
                                </p>
                                <blockquote class="tw-quote">
                                    “{t.quote}”
                                </blockquote>
                                <footer class="tw-sig">
                                    <div class="tw-signee">
                                        <p class="tw-name">{t.name}</p>
                                        <p class="tw-role">{t.role}</p>
                                    </div>
                                    {t.stamp && (
                                        <span
                                            class="tw-stamp"
                                            style={`--tilt: ${t.tilt}deg`}
                                        >
                                            {t.stamp}
                                        </span>
                                    )}
                                </footer>
                            </article>
                        ))}
                    </div>
                ))
            }
        </div>

        <button class="tw-arrow tw-prev" data-tw-prev disabled>
            <span class="visually-hidden">Previous sheet</span>
            <span aria-hidden="true">←</span>
        </button>
        <button class="tw-arrow tw-next" data-tw-next>
            <span class="visually-hidden">Next sheet</span>
            <span aria-hidden="true">→</span>
        </button>
    </div>

    <div class="tw-footer reveal">
        <p class="tw-tally">NEWEST FIRST — NO. {newestNum} AND COUNTING</p>
        <div class="tw-pager">
            {/* Mobile shows the count here, above the bars (hidden on desktop). */}
            <p class="tw-count tw-count-inline" data-tw-count>
                {total} ON FILE — SHEET 1 / {pages.length}
            </p>
            <div class="tw-bars" data-tw-bars>
                {
                    pages.map((_, p) => (
                        <button
                            class="tw-bar"
                            data-tw-bar={p}
                            aria-label={`Sheet ${p + 1}`}
                            aria-current={p === 0 ? "true" : undefined}
                        />
                    ))
                }
            </div>
            <p class="tw-hint">SWIPE, DRAG, OR <span aria-hidden="true">← →</span><span class="visually-hidden">arrow keys</span></p>
        </div>
    </div>

    <p class="visually-hidden" data-tw-live aria-live="polite"></p>
</section>

<style>
    .sheet {
        padding: var(--space-section) var(--space-gutter) 80px;
    }

    .tw-count {
        font-family: var(--font-mono);
        font-size: 11px;
        letter-spacing: 0.14em;
        color: var(--muted);
    }

    /* ------- carousel track ------- */

    .tw-carousel {
        position: relative;
        margin-top: 4px;
    }

    .tw-track {
        display: flex;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
        /* The drawer slides; it never scrolls the page sideways. */
        overscroll-behavior-x: contain;
    }

    .tw-track::-webkit-scrollbar {
        display: none;
    }

    /* Snap fights manual scrollLeft while the mouse drags the drawer. */
    .tw-track.is-dragging {
        scroll-snap-type: none;
    }

    .tw-page {
        flex: 0 0 100%;
        scroll-snap-align: start;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        grid-auto-rows: 1fr;
        background: var(--panel);
        border: 1px solid var(--line);
    }

    /* ------- cards ------- */

    .tw-card {
        padding: 26px 28px;
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    /* Internal dividers: right edge of cols 1–2, bottom edge of row 1. */
    .tw-card:not(:nth-child(3n)) {
        border-right: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
    }

    .tw-card:nth-child(-n + 3) {
        border-bottom: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
    }

    .tw-meta {
        display: flex;
        justify-content: space-between;
        font-family: var(--font-mono);
        font-size: 9px;
        letter-spacing: 0.16em;
        color: var(--faint);
        line-height: normal;
    }

    .tw-quote {
        font-family: var(--font-display);
        font-style: italic;
        font-size: 18px;
        line-height: 1.5;
        flex: 1;
    }

    .tw-sig {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 12px;
    }

    .tw-signee {
        flex: 1;
        border-top: 1px solid color-mix(in srgb, var(--ink) 25%, transparent);
        padding-top: 10px;
    }

    .tw-name {
        font-family: var(--font-display);
        font-style: italic;
        font-size: 19px;
    }

    .tw-role {
        font-family: var(--font-mono);
        font-size: 9px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
        margin-top: 3px;
        line-height: normal;
    }

    .tw-stamp {
        font-family: var(--font-mono);
        font-size: 8.5px;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--accent);
        border: 1px solid color-mix(in srgb, var(--accent) 65%, transparent);
        padding: 5px 9px;
        transform: rotate(var(--tilt, -4deg));
        white-space: nowrap;
        line-height: normal;
    }

    /* ------- arrows ------- */

    .tw-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--bg);
        border: 1px solid color-mix(in srgb, var(--accent) 50%, transparent);
        color: var(--accent);
        font-family: var(--font-mono);
        font-size: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: var(--tw-arrow-shadow, 0 8px 28px rgba(0, 0, 0, 0.5));
        transition:
            background var(--dur-hover) var(--ease),
            border-color var(--dur-hover) var(--ease),
            color var(--dur-hover) var(--ease);
        z-index: 1;
    }

    :global([data-theme="light"]) .tw-arrow {
        --tw-arrow-shadow: 0 8px 28px rgba(34, 28, 19, 0.18);
    }

    .tw-arrow:hover:not(:disabled) {
        background: var(--panel);
    }

    .tw-arrow:disabled {
        border-color: color-mix(in srgb, var(--ink) 20%, transparent);
        /* Disabled affordance (AA-exempt): deep-faint ≈ ink 24% over bg. */
        color: color-mix(in srgb, var(--ink) 24%, var(--bg));
        box-shadow: none;
        cursor: default;
    }

    .tw-prev {
        left: -20px;
    }

    .tw-next {
        right: -20px;
    }

    /* ------- footer row ------- */

    .tw-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-top: 20px;
        font-family: var(--font-mono);
        font-size: 9px;
        letter-spacing: 0.14em;
        color: var(--faint);
        line-height: normal;
    }

    .tw-tally,
    .tw-hint {
        text-transform: uppercase;
    }

    .tw-pager {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .tw-count-inline {
        display: none;
    }

    .tw-bars {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .tw-bar {
        width: 26px;
        height: 14px;
        border-top: 2px solid color-mix(in srgb, var(--ink) 18%, transparent);
        transition: border-color var(--dur-hover) var(--ease);
    }

    .tw-bar:hover {
        border-top-color: color-mix(in srgb, var(--ink) 40%, transparent);
    }

    .tw-bar[aria-current="true"] {
        border-top-color: var(--accent);
    }

    .tw-hint {
        margin-left: 8px;
    }

    /* ------- 900px: sheets of 4 (2×2) ------- */

    @media (max-width: 900px) {
        .tw-page {
            grid-template-columns: 1fr 1fr;
        }

        .tw-card,
        .tw-card:not(:nth-child(3n)),
        .tw-card:nth-child(-n + 3) {
            border-right: none;
            border-bottom: none;
        }

        .tw-card:nth-child(2n + 1) {
            border-right: 1px solid
                color-mix(in srgb, var(--ink) 12%, transparent);
        }

        .tw-card:nth-child(-n + 2) {
            border-bottom: 1px solid
                color-mix(in srgb, var(--ink) 12%, transparent);
        }
    }

    /* ------- 640px: one card per sheet ------- */

    @media (max-width: 640px) {
        .sheet {
            padding-bottom: 56px;
        }

        .tw-page {
            grid-template-columns: 1fr;
        }

        .tw-card,
        .tw-card:nth-child(2n + 1),
        .tw-card:nth-child(-n + 2) {
            border-right: none;
            border-bottom: none;
        }

        .tw-card {
            padding: 22px 20px;
        }

        /* Arrows would overhang into the 20px gutter — tuck them inside. */
        .tw-prev {
            left: -10px;
        }

        .tw-next {
            right: -10px;
        }

        /* Header count hides; the footer shows it above the bars instead. */
        :global(.section-header) .tw-count {
            display: none;
        }

        .tw-footer {
            flex-direction: column;
            align-items: flex-start;
        }

        .tw-pager {
            flex-wrap: wrap;
        }

        .tw-count-inline {
            display: block;
            flex-basis: 100%;
        }

        .tw-bar {
            width: 18px;
        }
    }
</style>

<script>
    // Carousel: responsive re-chunking + arrows, bars, drag, and ← → keys.
    // Native scroll-snap does the sliding (and elastic overscroll on touch);
    // JS only re-chunks pages, drives programmatic scrolls, and syncs chrome.
    const carousel = document.querySelector<HTMLElement>("[data-tw-carousel]");

    if (carousel) {
        const track = carousel.querySelector<HTMLElement>("[data-tw-track]")!;
        const prev = carousel.querySelector<HTMLButtonElement>("[data-tw-prev]")!;
        const next = carousel.querySelector<HTMLButtonElement>("[data-tw-next]")!;
        const section = document.getElementById("testimonials")!;
        const bars = section.querySelector<HTMLElement>("[data-tw-bars]")!;
        const counts = section.querySelectorAll<HTMLElement>("[data-tw-count]");
        const live = section.querySelector<HTMLElement>("[data-tw-live]")!;
        const cards = Array.from(track.querySelectorAll<HTMLElement>(".tw-card"));
        const total = cards.length;

        const reduceMotion = () =>
            window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        const mqTablet = window.matchMedia("(max-width: 900px)");
        const mqMobile = window.matchMedia("(max-width: 640px)");
        const pageSize = () => (mqMobile.matches ? 1 : mqTablet.matches ? 4 : 6);

        /* Astro's scoped styles key off a data-astro-cid-* attribute; elements
           built here must carry it or .tw-page/.tw-bar CSS won't match them. */
        const scopeAttrs = Array.from(
            track.querySelector(".tw-page")?.attributes ?? [],
        ).filter((a) => a.name.startsWith("data-astro-cid"));
        const withScope = <T extends HTMLElement>(el: T): T => {
            scopeAttrs.forEach((a) => el.setAttribute(a.name, a.value));
            return el;
        };

        let perPage = 6; // matches the server-rendered chunking
        let page = 0;
        let pageCount = Math.ceil(total / 6);

        const currentPage = () =>
            Math.min(
                pageCount - 1,
                Math.max(0, Math.round(track.scrollLeft / track.clientWidth)),
            );

        function sync(announce: boolean) {
            page = currentPage();
            prev.disabled = page === 0;
            next.disabled = page === pageCount - 1;
            bars.querySelectorAll<HTMLElement>(".tw-bar").forEach((bar, i) => {
                if (i === page) bar.setAttribute("aria-current", "true");
                else bar.removeAttribute("aria-current");
            });
            const label = `${total} ON FILE — SHEET ${page + 1} / ${pageCount}`;
            counts.forEach((el) => (el.textContent = label));
            if (announce) live.textContent = `Sheet ${page + 1} of ${pageCount}`;
        }

        function goTo(p: number, announce = true) {
            const target = Math.min(pageCount - 1, Math.max(0, p));
            track.scrollTo({
                left: target * track.clientWidth,
                behavior: reduceMotion() ? "auto" : "smooth",
            });
            // Sync immediately so rapid clicks step through pages.
            page = target;
            prev.disabled = page === 0;
            next.disabled = page === pageCount - 1;
            if (announce) live.textContent = `Sheet ${page + 1} of ${pageCount}`;
        }

        /* Re-chunk the register into sheets of 6 / 4 / 1 per breakpoint.
           Cards keep their order; only the page wrappers are rebuilt. */
        function layout() {
            const size = pageSize();
            if (size === perPage) return;
            const anchor = cards[page * (perPage || size)] ?? cards[0];
            perPage = size;
            pageCount = Math.ceil(total / size);

            const frag = document.createDocumentFragment();
            for (let p = 0; p < pageCount; p++) {
                const div = withScope(document.createElement("div"));
                div.className = "tw-page";
                div.setAttribute("role", "group");
                div.setAttribute("aria-label", `Sheet ${p + 1} of ${pageCount}`);
                cards
                    .slice(p * size, (p + 1) * size)
                    .forEach((c) => div.appendChild(c));
                frag.appendChild(div);
            }
            track.replaceChildren(frag);

            bars.replaceChildren(
                ...Array.from({ length: pageCount }, (_, p) => {
                    const b = withScope(document.createElement("button"));
                    b.className = "tw-bar";
                    b.dataset.twBar = String(p);
                    b.setAttribute("aria-label", `Sheet ${p + 1}`);
                    return b;
                }),
            );

            // Keep the sheet holding the previously visible card in view.
            const target = Math.floor(cards.indexOf(anchor) / size);
            track.scrollTo({ left: target * track.clientWidth, behavior: "auto" });
            sync(false);
        }

        // ------- wiring -------

        prev.addEventListener("click", () => goTo(page - 1));
        next.addEventListener("click", () => goTo(page + 1));

        bars.addEventListener("click", (e) => {
            const bar = (e.target as HTMLElement).closest<HTMLElement>(
                "[data-tw-bar]",
            );
            if (bar) goTo(Number(bar.dataset.twBar));
        });

        let scrollRaf = 0;
        track.addEventListener(
            "scroll",
            () => {
                cancelAnimationFrame(scrollRaf);
                scrollRaf = requestAnimationFrame(() => sync(false));
            },
            { passive: true },
        );

        // Mouse drag (touch swipes natively). Snap is suspended mid-drag.
        let dragFrom = 0;
        let dragStartLeft = 0;
        let dragged = false;
        track.addEventListener("pointerdown", (e) => {
            if (e.pointerType !== "mouse" || e.button !== 0) return;
            dragFrom = e.clientX;
            dragStartLeft = track.scrollLeft;
            dragged = false;
            track.classList.add("is-dragging");
            track.setPointerCapture(e.pointerId);
        });
        track.addEventListener("pointermove", (e) => {
            if (!track.classList.contains("is-dragging")) return;
            const dx = e.clientX - dragFrom;
            if (Math.abs(dx) > 4) dragged = true;
            track.scrollLeft = dragStartLeft - dx;
        });
        const endDrag = () => {
            if (!track.classList.contains("is-dragging")) return;
            track.classList.remove("is-dragging");
            if (dragged) goTo(currentPage(), false);
        };
        track.addEventListener("pointerup", endDrag);
        track.addEventListener("pointercancel", endDrag);

        // ← / → page the register while it's in view (same scoping as the
        // hero's R shortcut: no modifiers, not typing, section on screen).
        document.addEventListener("keydown", (e) => {
            if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
            if (e.metaKey || e.ctrlKey || e.altKey) return;
            const t = e.target as HTMLElement;
            if (t.closest("input, textarea, select, [contenteditable]")) return;
            const rect = section.getBoundingClientRect();
            if (
                rect.bottom <= 0 ||
                rect.top >= document.documentElement.clientHeight
            )
                return;
            e.preventDefault();
            goTo(page + (e.key === "ArrowRight" ? 1 : -1));
        });

        let resizeRaf = 0;
        window.addEventListener("resize", () => {
            cancelAnimationFrame(resizeRaf);
            resizeRaf = requestAnimationFrame(() => {
                layout();
                // Re-anchor to the current sheet after width changes.
                track.scrollTo({
                    left: page * track.clientWidth,
                    behavior: "auto",
                });
            });
        });

        layout();
    }
</script>
