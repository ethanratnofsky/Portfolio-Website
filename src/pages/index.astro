---
import Base from "../layouts/Base.astro";
import HeroSection from "../components/hero/HeroSection.astro";
import WorkSheet from "../components/work/WorkSheet.astro";
import DesignSheet from "../components/galleries/DesignSheet.astro";
import PhotoSheet from "../components/galleries/PhotoSheet.astro";
import AboutSheet from "../components/about/AboutSheet.astro";
import ContactSheet from "../components/contact/ContactSheet.astro";
---

<Base>
    {/* Legacy HashRouter URLs (/#/projects/x) → new routes. Old UFAR id was uppercase. */}
    <script is:inline>
        if (window.location.hash.startsWith("#/")) {
            var p = window.location.hash.slice(2).replace(/\/+$/, "");
            var map = {
                projects: "/#work",
                experience: "/#about",
                gallery: "/#design",
                "coming-soon": "/#contact",
            };
            var m = p.match(/^projects\/([\w-]+)/);
            window.location.replace(
                m
                    ? "/work/" + (m[1] === "UFAR" ? "ufar" : m[1])
                    : Object.prototype.hasOwnProperty.call(map, p)
                      ? map[p]
                      : "/",
            );
        }
    </script>

    <main id="main-content">
        <HeroSection />
        <WorkSheet />
        <DesignSheet />
        <PhotoSheet />
        <AboutSheet />
        <ContactSheet />
    </main>
</Base>
